// Flux Labs — Phase 1 + Phase 2 foundation schema
// Phase 2 Student Model + Knowledge Foundation.
// See docs/PHASE2_ARCHITECTURE.md (approved) and docs/STUDENT_MODEL.md.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Auth.js / NextAuth models
// ---------------------------------------------------------------------------

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts             Account[]
  sessions             Session[]
  studentProfile       StudentProfile?
  entitlements         Entitlement[]
  usageRecords         UsageRecord[]
  trials               Trial[]
  auditLogs            AuditLog[]
  aiInteractions       AIInteraction[]

  // Phase 2 student-owned
  studentAttributes    StudentAttribute[]
  studentGoals         StudentGoal[]
  onboardingSessions   OnboardingSession[]
  studentObservations  StudentObservation[]
  learningEvidence     LearningEvidence[]
  studentConceptStates StudentConceptState[]
  studentMisconceptions StudentMisconception[]
  userConcepts         Concept[] @relation("UserCreatedConcepts")

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// ---------------------------------------------------------------------------
// Student profile foundation (Phase 2: onboardingVersion / onboardingSkippedAt)
// ---------------------------------------------------------------------------

model StudentProfile {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  displayName   String?
  academicLevel String?
  timezone      String? @default("UTC")
  onboardingCompletedAt DateTime?
  onboardingVersion     String?
  onboardingSkippedAt   DateTime?

  // Explicit preferences — also mirrored into StudentAttribute for provenance
  preferredAssistanceStyle String?
  goalsSummary             String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("student_profiles")
}

// ---------------------------------------------------------------------------
// Phase 2 — provenance / student model enums
// ---------------------------------------------------------------------------

enum ProvenanceKind {
  EXPLICIT
  IMPORTED
  OBSERVED
  INFERRED
  HYPOTHESIS
}

enum GoalStatus {
  ACTIVE
  ACHIEVED
  ABANDONED
}

enum OnboardingSessionStatus {
  IN_PROGRESS
  COMPLETED
  DISMISSED
}

enum ConceptSource {
  SYSTEM
  USER
}

enum ConceptRelationType {
  PREREQUISITE
  RELATED
}

enum MasteryLevel {
  UNKNOWN
  INTRODUCED
  DEVELOPING
  PROFICIENT
  MASTERED
}

enum EvidenceKind {
  SELF_REPORT
  PRACTICE_SUCCESS
  PRACTICE_FAILURE
  TUTOR_SIGNAL
  QUIZ_ITEM
  REVIEW
}

enum EvidencePolarity {
  SUPPORTS_HIGHER
  SUPPORTS_LOWER
  NEUTRAL
}

enum MisconceptionStatus {
  ACTIVE
  RESOLVED
  DISMISSED
}

// ---------------------------------------------------------------------------
// Phase 2 — StudentAttribute (registry-controlled; one active per user+key)
// ---------------------------------------------------------------------------

model StudentAttribute {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  key         String
  valueJson   Json
  provenance  ProvenanceKind
  confidence  Float
  source      String
  supersededAt   DateTime?
  supersededById String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, key])
  @@index([userId, supersededAt])
  // Partial unique: one active (supersededAt IS NULL) per (userId, key)
  // Enforced via SQL migration — Prisma cannot express the WHERE predicate.
  @@map("student_attributes")
}

model StudentGoal {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  title       String
  description String? @db.Text
  category    String?
  status      GoalStatus @default(ACTIVE)
  priority    Int?
  provenance  ProvenanceKind
  confidence  Float
  source      String
  targetDate  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, status])
  @@map("student_goals")
}

model OnboardingSession {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  version     String
  status      OnboardingSessionStatus @default(IN_PROGRESS)
  startedAt   DateTime @default(now())
  completedAt DateTime?

  answers OnboardingAnswer[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, status])
  @@map("onboarding_sessions")
}

model OnboardingAnswer {
  id        String @id @default(cuid())
  sessionId String
  session   OnboardingSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  questionId String
  answerJson Json?
  skipped    Boolean @default(false)

  createdAt DateTime @default(now())

  @@unique([sessionId, questionId])
  @@map("onboarding_answers")
}

model StudentObservation {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  category   String
  type       String
  summary    String
  provenance ProvenanceKind @default(OBSERVED)
  confidence Float
  source     String
  // Auxiliary non-relational only — never DB ID arrays
  metadata   Json?

  createdAt DateTime @default(now())

  learningEvidence LearningEvidence[]

  @@index([userId, createdAt])
  @@index([userId, category, createdAt])
  @@map("student_observations")
}

model LearningEvidence {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  conceptId     String?
  concept       Concept? @relation(fields: [conceptId], references: [id], onDelete: SetNull)
  observationId String?
  observation   StudentObservation? @relation(fields: [observationId], references: [id], onDelete: SetNull)

  kind     EvidenceKind
  polarity EvidencePolarity
  weight   Float @default(1)
  source   String
  summary  String
  // Auxiliary non-relational only — never DB ID arrays / FK substitutes
  metadata Json?

  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([userId, conceptId, createdAt])
  @@map("learning_evidence")
}

model StudentConceptState {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  conceptId String
  concept   Concept @relation(fields: [conceptId], references: [id], onDelete: Cascade)

  mastery        MasteryLevel @default(UNKNOWN)
  confidence     Float
  provenance     ProvenanceKind
  source         String
  lastEvidenceAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, conceptId])
  @@index([userId, mastery])
  @@map("student_concept_states")
}

model StudentMisconception {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  conceptId String?
  concept   Concept? @relation(fields: [conceptId], references: [id], onDelete: SetNull)

  statement  String
  status     MisconceptionStatus @default(ACTIVE)
  provenance ProvenanceKind
  confidence Float
  source     String
  resolvedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, status])
  @@index([userId, conceptId])
  @@map("student_misconceptions")
}

// ---------------------------------------------------------------------------
// Phase 2 — Knowledge foundation (global catalog; not user-owned)
// ---------------------------------------------------------------------------

model Subject {
  id          String  @id @default(cuid())
  slug        String  @unique
  name        String
  description String?

  topics Topic[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("subjects")
}

model Topic {
  id          String  @id @default(cuid())
  subjectId   String
  subject     Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  slug        String
  name        String
  description String?

  concepts Concept[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([subjectId, slug])
  @@index([subjectId])
  @@map("topics")
}

model Concept {
  id          String        @id @default(cuid())
  topicId     String
  topic       Topic         @relation(fields: [topicId], references: [id], onDelete: Cascade)
  slug        String
  name        String
  description String?
  source      ConceptSource @default(SYSTEM)
  createdByUserId String?
  createdByUser   User?     @relation("UserCreatedConcepts", fields: [createdByUserId], references: [id], onDelete: Cascade)

  fromRelations ConceptRelation[] @relation("ConceptRelationFrom")
  toRelations   ConceptRelation[] @relation("ConceptRelationTo")
  conceptStates StudentConceptState[]
  misconceptions StudentMisconception[]
  learningEvidence LearningEvidence[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([topicId, slug])
  @@index([topicId])
  @@index([createdByUserId])
  @@map("concepts")
}

model ConceptRelation {
  id            String              @id @default(cuid())
  fromConceptId String
  fromConcept   Concept             @relation("ConceptRelationFrom", fields: [fromConceptId], references: [id], onDelete: Cascade)
  toConceptId   String
  toConcept     Concept             @relation("ConceptRelationTo", fields: [toConceptId], references: [id], onDelete: Cascade)
  type          ConceptRelationType

  createdAt DateTime @default(now())

  @@unique([fromConceptId, toConceptId, type])
  @@index([fromConceptId])
  @@index([toConceptId])
  @@map("concept_relations")
}

// ---------------------------------------------------------------------------
// Entitlements, trial, usage (server-side enforcement)
// ---------------------------------------------------------------------------

enum PlanTier {
  FREE_TRIAL
  PLUS
  PRO
}

enum EntitlementStatus {
  ACTIVE
  EXPIRED
  CANCELLED
  SUSPENDED
}

model Entitlement {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  plan       PlanTier          @default(FREE_TRIAL)
  status     EntitlementStatus @default(ACTIVE)
  startsAt   DateTime          @default(now())
  endsAt     DateTime?
  externalSubscriptionId String?
  metadata               Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, status])
  // Partial unique: at most one ACTIVE entitlement per user (see migration SQL)
  @@map("entitlements")
}

model Trial {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  startedAt   DateTime  @default(now())
  endsAt      DateTime
  convertedAt DateTime?
  expiredAt   DateTime?

  aiSessionsUsed           Int @default(0)
  documentAnalysesUsed     Int @default(0)
  advancedTutoringUsed     Int @default(0)
  estimatedCostMicros      Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("trials")
}

enum UsageCapability {
  AI_SESSION
  DOCUMENT_ANALYSIS
  ADVANCED_TUTORING
  GENERAL
}

model UsageRecord {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  capability      UsageCapability
  feature         String
  aiTaskType      String?
  modelKey        String?
  inputTokens     Int?
  outputTokens    Int?
  estimatedCostMicros Int @default(0)
  latencyMs       Int?
  success         Boolean @default(true)
  errorCode       String?
  metadata        Json?

  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([userId, capability, createdAt])
  @@index([feature, createdAt])
  @@map("usage_records")
}

model AIInteraction {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  taskType       String
  assistanceMode String?
  modelKey       String?
  requestSummary String?
  success        Boolean @default(true)

  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@map("ai_interactions")
}

model AuditLog {
  id     String  @id @default(cuid())
  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  action     String
  resource   String?
  resourceId String?
  ipHash     String?
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([userId, createdAt])
  @@index([action, createdAt])
  @@map("audit_logs")
}
