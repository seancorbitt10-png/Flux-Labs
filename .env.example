# Required
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/flux_labs?schema=public"
AUTH_SECRET="generate-with-openssl-rand-base64-32"
AUTH_URL="http://localhost:3000"

# ---------------------------------------------------------------------------
# AI provider (server-only). Production AI is OFF by default.
# ---------------------------------------------------------------------------
# AI_PRODUCTION_ENABLED=false
# AI_PRODUCTION_CONFIRM=
# AI_PROVIDER=stub
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# AI_TIMEOUT_MS=25000
# AI_MAX_OUTPUT_TOKENS=800
# AI_MAX_INPUT_TOKENS=8000
# AI_MAX_INPUT_UTF16_UNITS=64000
# AI_MODEL_FLUX_FAST=gpt-4o-mini
# AI_MODEL_FLUX_STANDARD=gpt-4o-mini
# AI_MODEL_FLUX_ADVANCED=gpt-4o

# ---------------------------------------------------------------------------
# Stripe billing (server-only).
# Live billing remains intentionally disabled until the Stripe account,
# products/prices, and webhook are explicitly configured.
# ---------------------------------------------------------------------------
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_PRICE_PLUS=price_...   # exactly $8.00 USD/month
# STRIPE_PRICE_PRO=price_...    # exactly $12.00 USD/month
