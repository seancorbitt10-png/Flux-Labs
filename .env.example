# Required
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/flux_labs?schema=public"
AUTH_SECRET="generate-with-openssl-rand-base64-32"
AUTH_URL="http://localhost:3000"

# ---------------------------------------------------------------------------
# AI provider (server-only). Production AI is OFF by default.
# Having OPENAI_API_KEY set does NOT enable real AI — you must also set
# AI_PRODUCTION_ENABLED=true and AI_PROVIDER=openai.
# Never expose these values to the browser / client bundle.
# ---------------------------------------------------------------------------
# AI_PRODUCTION_ENABLED=false
# AI_PROVIDER=stub
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# AI_TIMEOUT_MS=25000
# AI_MAX_OUTPUT_TOKENS=800  # cannot exceed envelope (800)
# AI_MAX_INPUT_CHARS=12000
# AI_MODEL_FLUX_FAST=gpt-4o-mini
# AI_MODEL_FLUX_STANDARD=gpt-4o-mini
# AI_MODEL_FLUX_ADVANCED=gpt-4o
